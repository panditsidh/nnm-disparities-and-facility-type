{com}. use "$dataset", clear
{txt}
{com}. 
. replace prior = 0 if missing(prior)
{txt}(203,686 real changes made)

{com}. 
. * Keep rounds / residence first.
. keep if inlist(round, `r')
{txt}(52,002 observations deleted)

{com}. keep if `residence' == 1
{txt}(109,480 observations deleted)

{com}. 
. * Keep five analytic social groups.
. keep if inrange(group, 1, 5)
{txt}(5,861 observations deleted)

{com}. 
. * Unique observation ID so leave-one-out composition is transparent.
. gen long obsid_comp = _n
{txt}
{com}. 
. tempfile base
{txt}
{com}. save `base', replace
