. *------------------------------------------------------------
. * Loop over regions and comparison groups
. *------------------------------------------------------------
. 
. foreach region of local regions {c -(}
{txt}  2{com}. 
.     local reglabel : variable label `region'
{txt}  3{com}.     if "`reglabel'" == "" local reglabel "`region'"
{txt}  4{com}. 
.     di as text ""
{txt}  5{com}.     di as text "======================================================================"
{txt}  6{com}.     di as text "REGION: `reglabel'"
{txt}  7{com}.     di as text "======================================================================"
{txt}  8{com}. 
.     foreach g of local groups {c -(}
{txt}  9{com}. 
.         use `base', clear
{txt} 10{com}. 
.         local gname "`groupname`g''"
{txt} 11{com}. 
.         *--------------------------------------------------------
.         * Construct higher-ranking status for THIS comparison
.         * using all five analytic social groups.
.         *--------------------------------------------------------
. 
.         gen byte higher_rank = .
{txt} 12{com}. 
.         if inlist(`g', 1, 2) {c -(}
{txt} 13{com}.             * For Adivasi / Dalit:
.             * higher ranking = OBC, Forward Hindu, Muslim.
.             replace higher_rank = 1 if inlist(group, 3, 4, 5)
{txt} 14{com}.             replace higher_rank = 0 if inlist(group, 1, 2)
{txt} 15{com}.         {c )-}
{txt} 16{com}.         else if inlist(`g', 3, 5) {c -(}
{txt} 17{com}.             * For OBC / Muslim:
.             * higher ranking = Forward Hindu only.
.             replace higher_rank = 1 if group == 4
{txt} 18{com}.             replace higher_rank = 0 if inlist(group, 1, 2, 3, 5)
{txt} 19{com}.         {c )-}
{txt} 20{com}. 
.         *--------------------------------------------------------
.         * PSU composition from ALL rural births in these rounds.
.         *
.         * v005 scale cancels in the ratio.
.         *--------------------------------------------------------
. 
.         gen double comp_den_i = v005
{txt} 21{com}.         gen double comp_num_i = v005 * higher_rank
{txt} 22{com}. 
.         bysort psu: egen double comp_den_psu = total(comp_den_i)
{txt} 23{com}.         bysort psu: egen double comp_num_psu = total(comp_num_i)
{txt} 24{com}. 
.         * Ordinary PSU share.
.         gen double higher_share_psu = comp_num_psu / comp_den_psu
{txt} 25{com}. 
.         * Leave-one-out PSU share.
.         gen double comp_den_loo = comp_den_psu - comp_den_i
{txt} 26{com}.         gen double comp_num_loo = comp_num_psu - comp_num_i
{txt} 27{com}. 
.         gen double higher_share_psu_loo = ///
>             comp_num_loo / comp_den_loo if comp_den_loo > 0
{txt} 28{com}. 
.         label var higher_share_psu ///
>             "PSU share higher-ranking social groups"
{txt} 29{com}. 
.         label var higher_share_psu_loo ///
>             "PSU share higher-ranking social groups, leave-one-out"
{txt} 30{com}. 
. 
.         *--------------------------------------------------------
.         * Now impose the main regression sample restrictions.
.         *--------------------------------------------------------
. 
.         drop if home == 1
{txt} 31{com}.         keep if `region' == 1
{txt} 32{com}.         keep if inlist(group, 4, `g')
{txt} 33{com}. 
.         capture drop comp_group
{txt} 34{com}.         gen byte comp_group = .
{txt} 35{com}.         replace comp_group = 0 if group == 4
{txt} 36{com}.         replace comp_group = 1 if group == `g'
{txt} 37{com}. 
.         label define comp_group_lbl ///
>             0 "Forward Hindu" ///
>             1 "`gname'", replace
{txt} 38{com}.         label values comp_group comp_group_lbl
{txt} 39{com}. 
. 
.         *--------------------------------------------------------
.         * 1. Baseline controlled specification
.         *--------------------------------------------------------
. 
.         capture noisily reghdfe `outcome' ///
>             i.comp_group##i.private ///
>             `controls' ///
>             [aw = v005], ///
>             cluster(psu) absorb(sdist)
{txt} 40{com}. 
.         if _rc != 0 {c -(}
{txt} 41{com}.             di as error "`gname': baseline regression failed"
{txt} 42{com}.             continue
{txt} 43{com}.         {c )-}
{txt} 44{com}. 
.         local b0 = _b[1.comp_group#1.private]
{txt} 45{com}. 
.         quietly test 1.comp_group#1.private
{txt} 46{com}.         local p0 = r(p)
{txt} 47{com}. 
.         local N0 = e(N)
{txt} 48{com}. 
. 
.         *--------------------------------------------------------
.         * 2. Add LEAVE-ONE-OUT higher-ranking PSU share
.         *--------------------------------------------------------
. 
.         capture noisily reghdfe `outcome' ///
>             i.comp_group##i.private ///
>             c.higher_share_psu_loo ///
>             `controls' ///
>             [aw = v005], ///
>             cluster(psu) absorb(sdist)
{txt} 49{com}. 
.         if _rc != 0 {c -(}
{txt} 50{com}.             di as error "`gname': leave-one-out composition regression failed"
{txt} 51{com}.             continue
{txt} 52{com}.         {c )-}
{txt} 53{com}. 
.         local b1 = _b[1.comp_group#1.private]
{txt} 54{com}. 
.         quietly test 1.comp_group#1.private
{txt} 55{com}.         local p1 = r(p)
{txt} 56{com}. 
.         local bhr = _b[higher_share_psu_loo]
{txt} 57{com}. 
.         quietly test higher_share_psu_loo
{txt} 58{com}.         local phr = r(p)
{txt} 59{com}. 
.         local N1 = e(N)
{txt} 60{com}. 
.         * Change in interaction coefficient.
.         local db = `b1' - `b0'
{txt} 61{com}. 
.         * Percent change in magnitude, only if baseline is nonzero.
.         local pctchg = .
{txt} 62{com}.         if abs(`b0') > 1e-10 {c -(}
{txt} 63{com}.             local pctchg = 100 * (`b1' - `b0') / abs(`b0')
{txt} 64{com}.         {c )-}
{txt} 65{com}. 
. 
.         *--------------------------------------------------------
.         * 3. Sensitivity: ordinary, non-LOO PSU share
.         *--------------------------------------------------------
. 
.         capture noisily reghdfe `outcome' ///
>             i.comp_group##i.private ///
>             c.higher_share_psu ///
>             `controls' ///
>             [aw = v005], ///
>             cluster(psu) absorb(sdist)
{txt} 66{com}. 
.         if _rc == 0 {c -(}
{txt} 67{com}.             local b2 = _b[1.comp_group#1.private]
{txt} 68{com}. 
.             quietly test 1.comp_group#1.private
{txt} 69{com}.             local p2 = r(p)
{txt} 70{com}. 
.             local bhr2 = _b[higher_share_psu]
{txt} 71{com}. 
.             quietly test higher_share_psu
{txt} 72{com}.             local phr2 = r(p)
{txt} 73{com}.         {c )-}
{txt} 74{com}.         else {c -(}
{txt} 75{com}.             local b2 = .
{txt} 76{com}.             local p2 = .
{txt} 77{com}.             local bhr2 = .
{txt} 78{com}.             local phr2 = .
{txt} 79{com}.         {c )-}
{txt} 80{com}. 
. 
.         *--------------------------------------------------------
.         * Console summary
.         *--------------------------------------------------------
. 
.         di as text ""
{txt} 81{com}.         di as text "------------------------------------------------------------------"
{txt} 82{com}.         di as text "`gname' vs Forward Hindu"
{txt} 83{com}.         di as text "Higher-ranking definition: " ///
>             cond(inlist(`g',1,2), ///
>             "OBC + Forward Hindu + Muslim", ///
>             "Forward Hindu only")
{txt} 84{com}.         di as text "------------------------------------------------------------------"
{txt} 85{com}. 
.         di as result "Baseline interaction:            " ///
>             %9.2f `b0' "   p = " %6.4f `p0' ///
>             "   N = " %9.0fc `N0'
{txt} 86{com}. 
.         di as result "+ LOO higher-rank share:          " ///
>             %9.2f `b1' "   p = " %6.4f `p1' ///
>             "   N = " %9.0fc `N1'
{txt} 87{com}. 
.         di as result "Change in interaction:            " ///
>             %9.2f `db'
{txt} 88{com}. 
.         if `pctchg' < . {c -(}
{txt} 89{com}.             di as result "Percent change vs baseline:       " ///
>                 %9.1f `pctchg' "%"
{txt} 90{com}.         {c )-}
{txt} 91{com}. 
.         di as result "LOO higher-rank-share coefficient:" ///
>             %9.2f `bhr' "   p = " %6.4f `phr'
{txt} 92{com}. 
.         di as text ""
{txt} 93{com}.         di as text "Sensitivity using non-LOO PSU share:"
{txt} 94{com}. 
.         di as result "Interaction:                     " ///
>             %9.2f `b2' "   p = " %6.4f `p2'
{txt} 95{com}. 
.         di as result "Higher-rank-share coefficient:    " ///
>             %9.2f `bhr2' "   p = " %6.4f `phr2'
{txt} 96{com}.     {c )-}
{txt} 97{com}. {c )-}
{txt}
