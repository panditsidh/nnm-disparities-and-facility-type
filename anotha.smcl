. *------------------------------------------------------------
. * Loop over regions and comparison groups
. *------------------------------------------------------------
. 
. foreach region of local regions {c -(}
{txt}  2{com}. 
.     local reglabel : variable label `region'
{txt}  3{com}.     if "`reglabel'" == "" local reglabel "`region'"
{txt}  4{com}. 
.     di as text ""
{txt}  5{com}.     di as text "======================================================================"
{txt}  6{com}.     di as text "REGION: `reglabel'"
{txt}  7{com}.     di as text "======================================================================"
{txt}  8{com}. 
.     foreach g of local groups {c -(}
{txt}  9{com}. 
.         use `base', clear
{txt} 10{com}. 
.         local gname "`groupname`g''"
{txt} 11{com}. 
. 
.         *--------------------------------------------------------
.         * Define higher-ranking social groups
.         *--------------------------------------------------------
. 
.         gen byte higher_rank = .
{txt} 12{com}. 
.         if inlist(`g', 1, 2) {c -(}
{txt} 13{com}.             replace higher_rank = 1 if inlist(group, 3, 4, 5)
{txt} 14{com}.             replace higher_rank = 0 if inlist(group, 1, 2)
{txt} 15{com}.         {c )-}
{txt} 16{com}.         else if inlist(`g', 3, 5) {c -(}
{txt} 17{com}.             replace higher_rank = 1 if group == 4
{txt} 18{com}.             replace higher_rank = 0 if inlist(group, 1, 2, 3, 5)
{txt} 19{com}.         {c )-}
{txt} 20{com}. 
. 
.         *--------------------------------------------------------
.         * Construct weighted PSU social composition
.         * using ALL rural births in the five analytic groups
.         *--------------------------------------------------------
. 
.         gen double comp_den_i = v005
{txt} 21{com}.         gen double comp_num_i = v005 * higher_rank
{txt} 22{com}. 
.         bysort psu: egen double comp_den_psu = total(comp_den_i)
{txt} 23{com}.         bysort psu: egen double comp_num_psu = total(comp_num_i)
{txt} 24{com}. 
.         * Ordinary PSU share
.         gen double higher_share_psu = ///
>             comp_num_psu / comp_den_psu
{txt} 25{com}. 
.         * Leave-one-out PSU share
.         gen double comp_den_loo = comp_den_psu - comp_den_i
{txt} 26{com}.         gen double comp_num_loo = comp_num_psu - comp_num_i
{txt} 27{com}. 
.         gen double higher_share_psu_loo = ///
>             comp_num_loo / comp_den_loo ///
>             if comp_den_loo > 0
{txt} 28{com}. 
.         label var higher_share_psu ///
>             "PSU share higher-ranking social groups"
{txt} 29{com}. 
.         label var higher_share_psu_loo ///
>             "PSU share higher-ranking social groups, leave-one-out"
{txt} 30{com}. 
. 
.         *--------------------------------------------------------
.         * Main regression sample
.         *--------------------------------------------------------
. 
.         drop if home == 1
{txt} 31{com}.         keep if `region' == 1
{txt} 32{com}.         keep if inlist(group, 4, `g')
{txt} 33{com}. 
.         gen byte comp_group = .
{txt} 34{com}.         replace comp_group = 0 if group == 4
{txt} 35{com}.         replace comp_group = 1 if group == `g'
{txt} 36{com}. 
.         label define comp_group_lbl ///
>             0 "Forward Hindu" ///
>             1 "`gname'", replace
{txt} 37{com}.         label values comp_group comp_group_lbl
{txt} 38{com}. 
. 
.         *--------------------------------------------------------
.         * Preferred model: leave-one-out composition
.         *--------------------------------------------------------
. 
.         capture noisily reghdfe `outcome' ///
>             i.comp_group##i.private##c.higher_share_psu_loo ///
>             `controls' ///
>             [aw = v005], ///
>             cluster(psu) absorb(sdist)
{txt} 39{com}. 
.         if _rc != 0 {c -(}
{txt} 40{com}.             di as error "`gname': LOO three-way regression failed"
{txt} 41{com}.             continue
{txt} 42{com}.         {c )-}
{txt} 43{com}. 
.         local N = e(N)
{txt} 44{com}. 
.         * Three-way interaction:
.         * Does the comparison-vs-Forward difference in the
.         * private-public gap vary with higher-ranking share?
.         local triple = ///
>             _b[1.comp_group#1.private#c.higher_share_psu_loo]
{txt} 45{com}. 
.         quietly test ///
>             1.comp_group#1.private#c.higher_share_psu_loo
{txt} 46{com}.         local p_triple = r(p)
{txt} 47{com}. 
. 
.         *--------------------------------------------------------
.         * Composition percentiles in the ACTUAL regression sample
.         *--------------------------------------------------------
. 
.         quietly summarize higher_share_psu_loo ///
>             if e(sample), detail
{txt} 48{com}. 
.         local p25 = r(p25)
{txt} 49{com}.         local p50 = r(p50)
{txt} 50{com}.         local p75 = r(p75)
{txt} 51{com}. 
. 
.         *--------------------------------------------------------
.         * Difference in private-public gap relative to Forward
.         * at p25 / p50 / p75 of local composition
.         *
.         * DID(s) =
.         *   group#private
.         *   + s * group#private#higher_share
.         *--------------------------------------------------------
. 
.         quietly lincom ///
>             1.comp_group#1.private ///
>             + `p25' * ///
>             1.comp_group#1.private#c.higher_share_psu_loo
{txt} 52{com}. 
.         local did25 = r(estimate)
{txt} 53{com}.         local se25  = r(se)
{txt} 54{com}.         local p_did25 = r(p)
{txt} 55{com}. 
.         quietly lincom ///
>             1.comp_group#1.private ///
>             + `p50' * ///
>             1.comp_group#1.private#c.higher_share_psu_loo
{txt} 56{com}. 
.         local did50 = r(estimate)
{txt} 57{com}.         local se50  = r(se)
{txt} 58{com}.         local p_did50 = r(p)
{txt} 59{com}. 
.         quietly lincom ///
>             1.comp_group#1.private ///
>             + `p75' * ///
>             1.comp_group#1.private#c.higher_share_psu_loo
{txt} 60{com}. 
.         local did75 = r(estimate)
{txt} 61{com}.         local se75  = r(se)
{txt} 62{com}.         local p_did75 = r(p)
{txt} 63{com}. 
. 
.         *--------------------------------------------------------
.         * Optional: actual private-public gap within EACH group
.         * at the same three composition values
.         *--------------------------------------------------------
. 
.         quietly lincom ///
>             1.private ///
>             + `p25' * 1.private#c.higher_share_psu_loo
{txt} 64{com}.         local fwd25 = r(estimate)
{txt} 65{com}.         local p_fwd25 = r(p)
{txt} 66{com}. 
.         quietly lincom ///
>             1.private ///
>             + `p50' * 1.private#c.higher_share_psu_loo
{txt} 67{com}.         local fwd50 = r(estimate)
{txt} 68{com}.         local p_fwd50 = r(p)
{txt} 69{com}. 
.         quietly lincom ///
>             1.private ///
>             + `p75' * 1.private#c.higher_share_psu_loo
{txt} 70{com}.         local fwd75 = r(estimate)
{txt} 71{com}.         local p_fwd75 = r(p)
{txt} 72{com}. 
. 
.         quietly lincom ///
>             1.private ///
>             + 1.comp_group#1.private ///
>             + `p25' * 1.private#c.higher_share_psu_loo ///
>             + `p25' * 1.comp_group#1.private#c.higher_share_psu_loo
{txt} 73{com}.         local comp25 = r(estimate)
{txt} 74{com}.         local p_comp25 = r(p)
{txt} 75{com}. 
.         quietly lincom ///
>             1.private ///
>             + 1.comp_group#1.private ///
>             + `p50' * 1.private#c.higher_share_psu_loo ///
>             + `p50' * 1.comp_group#1.private#c.higher_share_psu_loo
{txt} 76{com}.         local comp50 = r(estimate)
{txt} 77{com}.         local p_comp50 = r(p)
{txt} 78{com}. 
.         quietly lincom ///
>             1.private ///
>             + 1.comp_group#1.private ///
>             + `p75' * 1.private#c.higher_share_psu_loo ///
>             + `p75' * 1.comp_group#1.private#c.higher_share_psu_loo
{txt} 79{com}.         local comp75 = r(estimate)
{txt} 80{com}.         local p_comp75 = r(p)
{txt} 81{com}. 
. 
.         *--------------------------------------------------------
.         * Sensitivity: ordinary non-LOO composition
.         *--------------------------------------------------------
. 
.         capture noisily reghdfe `outcome' ///
>             i.comp_group##i.private##c.higher_share_psu ///
>             `controls' ///
>             [aw = v005], ///
>             cluster(psu) absorb(sdist)
{txt} 82{com}. 
.         if _rc == 0 {c -(}
{txt} 83{com}.             local triple_raw = ///
>                 _b[1.comp_group#1.private#c.higher_share_psu]
{txt} 84{com}. 
.             quietly test ///
>                 1.comp_group#1.private#c.higher_share_psu
{txt} 85{com}.             local p_triple_raw = r(p)
{txt} 86{com}.         {c )-}
{txt} 87{com}.         else {c -(}
{txt} 88{com}.             local triple_raw = .
{txt} 89{com}.             local p_triple_raw = .
{txt} 90{com}.         {c )-}
{txt} 91{com}. 
. 
.         *--------------------------------------------------------
.         * Console summary
.         *--------------------------------------------------------
. 
.         di as text ""
{txt} 92{com}.         di as text "------------------------------------------------------------------"
{txt} 93{com}.         di as text "`gname' vs Forward Hindu"
{txt} 94{com}.         di as text "Higher-ranking definition: " ///
>             cond(inlist(`g',1,2), ///
>             "OBC + Forward Hindu + Muslim", ///
>             "Forward Hindu only")
{txt} 95{com}.         di as text "------------------------------------------------------------------"
{txt} 96{com}. 
.         di as result "N: " %9.0fc `N'
{txt} 97{com}. 
.         di as result "LOO composition p25 / p50 / p75: " ///
>             %6.3f `p25' "   " ///
>             %6.3f `p50' "   " ///
>             %6.3f `p75'
{txt} 98{com}. 
.         di as text ""
{txt} 99{com}.         di as result "THREE-WAY interaction:" ///
>             %10.2f `triple' ///
>             "   p = " %6.4f `p_triple'
{txt}100{com}. 
.         di as text ""
{txt}101{com}.         di as text "Difference in private-public gap:"
{txt}102{com}.         di as text "  (comparison group minus Forward Hindu)"
{txt}103{com}. 
.         di as result "At p25 composition: " ///
>             %9.2f `did25' ///
>             "   SE = " %8.2f `se25' ///
>             "   p = " %6.4f `p_did25'
{txt}104{com}. 
.         di as result "At p50 composition: " ///
>             %9.2f `did50' ///
