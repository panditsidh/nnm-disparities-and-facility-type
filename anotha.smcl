>             "   p = " %6.4f `p_did75'
{txt}106{com}. 
.         di as text ""
{txt}107{com}.         di as text "Private-public gap within each group:"
{txt}108{com}. 
.         di as result "Forward Hindu, p25 / p50 / p75: " ///
>             %8.2f `fwd25' "   " ///
>             %8.2f `fwd50' "   " ///
>             %8.2f `fwd75'
{txt}109{com}. 
.         di as result "`gname', p25 / p50 / p75: " ///
>             %8.2f `comp25' "   " ///
>             %8.2f `comp50' "   " ///
>             %8.2f `comp75'
{txt}110{com}. 
.         di as text ""
{txt}111{com}.         di as text "Sensitivity: non-LOO composition"
{txt}112{com}.         di as result "Three-way interaction:" ///
>             %10.2f `triple_raw' ///
