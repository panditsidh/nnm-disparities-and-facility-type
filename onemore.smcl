. /********************************************************************
> PART 1. PREPARE NFHS-4 HOUSEHOLD FILE
> ********************************************************************/
. 
. tempfile hr4 hr5 hh_comp
{txt}
{com}. 
. use "$nfhs4hr", clear
{txt}
{com}. 
. gen byte round = 4
{txt}
{com}. 
. * NFHS-4 household-head social-group variables:
. *   sh34 = religion
. *   sh36 = type of caste/tribe
. gen byte hr_group = .
{txt}(601,509 missing values generated)

{com}. 
. * Adivasi: Scheduled Tribe, regardless of religion
. replace hr_group = 1 if sh36 == 2
{txt}(114,100 real changes made)

{com}. 
. * Dalit: Scheduled Caste, regardless of religion
. replace hr_group = 2 if sh36 == 1
{txt}(108,434 real changes made)

{com}. 
. * Muslim: Muslim and not SC/ST
. replace hr_group = 5 if sh34 == 2 & missing(hr_group)
{txt}(67,461 real changes made)

{com}. 
. * OBC: Hindu or Sikh and OBC
. replace hr_group = 3 if sh36 == 3 & inlist(sh34,1,4)
{txt}(190,997 real changes made)

{com}. 
. * Forward Hindu: Hindu, not SC/ST/OBC
. replace hr_group = 4 if sh34 == 1 ///
>     & inlist(sh36,4,8,.) ///
>     & missing(hr_group)
{txt}(104,700 real changes made)

{com}. 
. label define hr_group_lbl ///
>     1 "Adivasi" ///
>     2 "Dalit" ///
>     3 "OBC" ///
>     4 "Forward Hindu" ///
>     5 "Muslim", replace
{txt}
{com}. label values hr_group hr_group_lbl
{txt}
{com}. 
. * Standardize identifiers / weight names
. rename hv000 v000
{res}{txt}
{com}. rename hv001 v001
{res}{txt}
{com}. rename hv002 v002
{res}{txt}
{com}. rename hv024 v024
{res}{txt}
{com}. rename hv025 v025
{res}{txt}
{com}. rename hv005 hh_weight
{res}{txt}
{com}. 
. keep ///
>     round ///
>     v000 v001 v002 v024 v025 ///
>     hh_weight hr_group
{txt}
{com}. 
. save `hr4', replace
