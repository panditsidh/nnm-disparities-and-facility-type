. /********************************************************************
> PART 2. PREPARE NFHS-5 HOUSEHOLD FILE
> ********************************************************************/
. 
. use "$nfhs5hr", clear
{txt}
{com}. 
. gen byte round = 5
{txt}
{com}. 
. * NFHS-5 household-head social-group variables from your existing code:
. *   sh47 = religion
. *   sh49 = type of caste/tribe
. gen byte hr_group = .
{txt}(636,699 missing values generated)

{com}. 
. * Adivasi: Scheduled Tribe, regardless of religion
. replace hr_group = 1 if sh49 == 2
{txt}(123,443 real changes made)

{com}. 
. * Dalit: Scheduled Caste, regardless of religion
. replace hr_group = 2 if sh49 == 1
{txt}(123,002 real changes made)

{com}. 
. * Muslim: Muslim and not SC/ST
. replace hr_group = 5 if sh47 == 2 & missing(hr_group)
{txt}(66,343 real changes made)

{com}. 
. * OBC: Hindu or Sikh and OBC
. replace hr_group = 3 if sh49 == 3 & inlist(sh47,1,4)
{txt}(201,303 real changes made)

{com}. 
. * Forward Hindu: Hindu, not SC/ST/OBC
. replace hr_group = 4 if sh47 == 1 ///
>     & inlist(sh49,4,8,.) ///
>     & missing(hr_group)
{txt}(105,914 real changes made)

{com}. 
. label values hr_group hr_group_lbl
{txt}
{com}. 
. rename hv000 v000
{res}{txt}
{com}. rename hv001 v001
{res}{txt}
{com}. rename hv002 v002
{res}{txt}
{com}. rename hv024 v024
{res}{txt}
{com}. rename hv025 v025
{res}{txt}
{com}. rename hv005 hh_weight
{res}{txt}
{com}. 
. keep ///
>     round ///
>     v000 v001 v002 v024 v025 ///
>     hh_weight hr_group
{txt}
{com}. 
