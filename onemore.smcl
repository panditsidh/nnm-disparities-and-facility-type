. /********************************************************************
> PART 3. STACK NFHS-4 AND NFHS-5 HOUSEHOLDS
> ********************************************************************/
. 
. use `hr4', clear
{txt}
{com}. append using `hr5'
{txt}(label {bf:{txt}HV025} already defined)
(label {bf:{txt}HV024} already defined)

{com}. 
. * Paper is rural
. keep if v025 == 2
{txt}(336,084 observations deleted)

{com}. 
. * IMPORTANT:
. * Do NOT drop households outside the five analytic groups before
. * creating the denominator. The denominator should represent all
. * sampled rural households in the PSU.
. *
. * Numerators below count only the five analytic social groups.
. * Households outside those groups remain in the denominator.
. 
. * Survey-specific PSU identifier
. egen long hh_psu = group(round v001 v024 v025)
{res}{txt}
{com}. 
. 
. /********************************************************************
> PART 4. PSU HOUSEHOLD SOCIAL COMPOSITION
> ********************************************************************/
. 
. * Weighted household totals
. bysort hh_psu: egen double total_w_hh = total(hh_weight)
{txt}
{com}. 
. foreach g in 1 2 3 4 5 {c -(}
{txt}  2{com}. 
.     gen double w_group`g' = ///
>         hh_weight * (hr_group == `g') if !missing(hr_group)
{txt}  3{com}. 
.     replace w_group`g' = 0 if missing(w_group`g')
{txt}  4{com}. 
.     bysort hh_psu: egen double total_w_group`g' = ///
>         total(w_group`g')
{txt}  5{com}. {c )-}
{txt}(20,573 missing values generated)
(20,573 real changes made)
(20,573 missing values generated)
(20,573 real changes made)
(20,573 missing values generated)
(20,573 real changes made)
(20,573 missing values generated)
(20,573 real changes made)
(20,573 missing values generated)
(20,573 real changes made)

{com}. 
. 
. *------------------------------------------------------------
. * Ordinary PSU shares
. *------------------------------------------------------------
. 
. gen double pct_psu_adivasi = total_w_group1 / total_w_hh
{txt}
{com}. gen double pct_psu_dalit   = total_w_group2 / total_w_hh
{txt}
{com}. gen double pct_psu_obc     = total_w_group3 / total_w_hh
{txt}
{com}. gen double pct_psu_forward = total_w_group4 / total_w_hh
{txt}
{com}. gen double pct_psu_muslim  = total_w_group5 / total_w_hh
{txt}
{com}. 
. 
. *------------------------------------------------------------
. * Leave-one-HOUSEHOLD-out shares
. *
. * Since we merge composition back to the focal birth's household,
. * this removes that household's own contribution to BOTH numerator
. * and denominator.
. *------------------------------------------------------------
. 
. gen double total_w_hh_loo = total_w_hh - hh_weight
{txt}
{com}. 
. foreach g in 1 2 3 4 5 {c -(}
{txt}  2{com}. 
.     gen double total_w_group`g'_loo = ///
>         total_w_group`g' - hh_weight * (hr_group == `g')
{txt}  3{com}. 
. {c )-}
{txt}
{com}. 
. 
. gen double pct_psu_adivasi_loo = ///
>     total_w_group1_loo / total_w_hh_loo ///
>     if total_w_hh_loo > 0
{txt}
{com}. 
. gen double pct_psu_dalit_loo = ///
>     total_w_group2_loo / total_w_hh_loo ///
>     if total_w_hh_loo > 0
{txt}
{com}. 
. gen double pct_psu_obc_loo = ///
>     total_w_group3_loo / total_w_hh_loo ///
>     if total_w_hh_loo > 0
{txt}
{com}. 
. gen double pct_psu_forward_loo = ///
>     total_w_group4_loo / total_w_hh_loo ///
>     if total_w_hh_loo > 0
{txt}
{com}. 
. gen double pct_psu_muslim_loo = ///
>     total_w_group5_loo / total_w_hh_loo ///
>     if total_w_hh_loo > 0
{txt}
{com}. 
. 
. *------------------------------------------------------------
. * Higher-ranking shares requested
. *------------------------------------------------------------
. 
. * Adivasi and Dalit:
. * higher ranking = OBC + Forward Hindu + Muslim
. gen double higher_adivasi = ///
>     pct_psu_obc + pct_psu_forward + pct_psu_muslim
{txt}
{com}. 
. gen double higher_dalit = ///
>     pct_psu_obc + pct_psu_forward + pct_psu_muslim
{txt}
{com}. 
. gen double higher_adivasi_loo = ///
>     pct_psu_obc_loo + pct_psu_forward_loo + pct_psu_muslim_loo
{txt}
{com}. 
. gen double higher_dalit_loo = ///
>     pct_psu_obc_loo + pct_psu_forward_loo + pct_psu_muslim_loo
{txt}
{com}. 
. 
. * OBC and Muslim:
. * higher ranking = Forward Hindu only
. gen double higher_obc = pct_psu_forward
{txt}
{com}. gen double higher_muslim = pct_psu_forward
{txt}
{com}. 
. gen double higher_obc_loo = pct_psu_forward_loo
{txt}
{com}. gen double higher_muslim_loo = pct_psu_forward_loo
{txt}
{com}. 
. 
. *------------------------------------------------------------
. * Keep one row per household for merge
. *------------------------------------------------------------
. 
. keep ///
>     round ///
>     v000 v001 v002 v024 v025 ///
>     hr_group ///
>     pct_psu_adivasi pct_psu_dalit pct_psu_obc ///
>     pct_psu_forward pct_psu_muslim ///
>     pct_psu_adivasi_loo pct_psu_dalit_loo pct_psu_obc_loo ///
>     pct_psu_forward_loo pct_psu_muslim_loo ///
>     higher_adivasi higher_dalit higher_obc higher_muslim ///
>     higher_adivasi_loo higher_dalit_loo higher_obc_loo higher_muslim_loo
{txt}
{com}. 
. isid round v000 v001 v002 v024 v025
{txt}
{com}. 
. save `hh_comp', replace
{txt}{p 0 4 2}
(file {bf}
/var/folders/tr/xr039_6d14gc3ld9ky66cxxr0000gn/T//S_00400.000005{rm}
not found)
