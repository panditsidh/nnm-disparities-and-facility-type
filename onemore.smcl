. /********************************************************************
> PART 6. THREE-WAY INTERACTION MODELS
> ********************************************************************/
. 
. foreach region of local regions {c -(}
{txt}  2{com}. 
.     local reglabel : variable label `region'
{txt}  3{com}.     if "`reglabel'" == "" local reglabel "`region'"
{txt}  4{com}. 
.     di as text ""
{txt}  5{com}.     di as text "======================================================================"
{txt}  6{com}.     di as text "REGION: `reglabel'"
{txt}  7{com}.     di as text "======================================================================"
{txt}  8{com}. 
.     foreach g of local groups {c -(}
{txt}  9{com}. 
.         use `birthbase', clear
{txt} 10{com}. 
.         local gname "`groupname`g''"
{txt} 11{com}. 
.         * Select relevant household-composition variable
.         if `g' == 1 {c -(}
{txt} 12{com}.             local hvar "higher_adivasi_loo"
{txt} 13{com}.             local hvar_raw "higher_adivasi"
{txt} 14{com}.         {c )-}
{txt} 15{com}.         else if `g' == 2 {c -(}
{txt} 16{com}.             local hvar "higher_dalit_loo"
{txt} 17{com}.             local hvar_raw "higher_dalit"
{txt} 18{com}.         {c )-}
{txt} 19{com}.         else if `g' == 3 {c -(}
{txt} 20{com}.             local hvar "higher_obc_loo"
{txt} 21{com}.             local hvar_raw "higher_obc"
{txt} 22{com}.         {c )-}
{txt} 23{com}.         else if `g' == 5 {c -(}
{txt} 24{com}.             local hvar "higher_muslim_loo"
{txt} 25{com}.             local hvar_raw "higher_muslim"
{txt} 26{com}.         {c )-}
{txt} 27{com}. 
. 
.         * Main paper sample
.         drop if home == 1
{txt} 28{com}.         keep if `region' == 1
{txt} 29{com}.         keep if inlist(group,4,`g')
{txt} 30{com}. 
.         gen byte comp_group = .
{txt} 31{com}.         replace comp_group = 0 if group == 4
{txt} 32{com}.         replace comp_group = 1 if group == `g'
{txt} 33{com}. 
.         label define comp_group_lbl ///
>             0 "Forward Hindu" ///
>             1 "`gname'", replace
{txt} 34{com}.         label values comp_group comp_group_lbl
{txt} 35{com}. 
. 
.         *--------------------------------------------------------
.         * Preferred model: leave-one-household-out composition
.         *--------------------------------------------------------
. 
.         capture noisily reghdfe `outcome' ///
>             i.comp_group##i.private##c.`hvar' ///
>             `controls' ///
>             [aw = v005], ///
>             cluster(psu) absorb(sdist)
{txt} 36{com}. 
.         if _rc != 0 {c -(}
{txt} 37{com}.             di as error "`gname': household-composition regression failed"
{txt} 38{com}.             continue
{txt} 39{com}.         {c )-}
{txt} 40{com}. 
.         local N = e(N)
{txt} 41{com}. 
.         local triple = ///
>             _b[1.comp_group#1.private#c.`hvar']
{txt} 42{com}. 
.         quietly test ///
>             1.comp_group#1.private#c.`hvar'
{txt} 43{com}.         local p_triple = r(p)
{txt} 44{com}. 
. 
.         * Composition percentiles in actual regression sample
.         quietly summarize `hvar' if e(sample), detail
{txt} 45{com}. 
.         local p25 = r(p25)
{txt} 46{com}.         local p50 = r(p50)
{txt} 47{com}.         local p75 = r(p75)
{txt} 48{com}. 
. 
.         *--------------------------------------------------------
.         * Comparison-vs-Forward difference in private-public gap
.         *--------------------------------------------------------
. 
.         quietly lincom ///
>             1.comp_group#1.private ///
>             + `p25' * 1.comp_group#1.private#c.`hvar'
{txt} 49{com}. 
.         local did25 = r(estimate)
{txt} 50{com}.         local se25 = r(se)
{txt} 51{com}.         local pdid25 = r(p)
{txt} 52{com}. 
. 
.         quietly lincom ///
>             1.comp_group#1.private ///
>             + `p50' * 1.comp_group#1.private#c.`hvar'
{txt} 53{com}. 
.         local did50 = r(estimate)
{txt} 54{com}.         local se50 = r(se)
{txt} 55{com}.         local pdid50 = r(p)
{txt} 56{com}. 
. 
.         quietly lincom ///
>             1.comp_group#1.private ///
>             + `p75' * 1.comp_group#1.private#c.`hvar'
{txt} 57{com}. 
.         local did75 = r(estimate)
{txt} 58{com}.         local se75 = r(se)
{txt} 59{com}.         local pdid75 = r(p)
{txt} 60{com}. 
. 
.         *--------------------------------------------------------
.         * Private-public gap within Forward Hindu
.         *--------------------------------------------------------
. 
.         quietly lincom ///
>             1.private ///
>             + `p25' * 1.private#c.`hvar'
{txt} 61{com}.         local fwd25 = r(estimate)
{txt} 62{com}. 
.         quietly lincom ///
>             1.private ///
>             + `p50' * 1.private#c.`hvar'
{txt} 63{com}.         local fwd50 = r(estimate)
{txt} 64{com}. 
.         quietly lincom ///
>             1.private ///
>             + `p75' * 1.private#c.`hvar'
{txt} 65{com}.         local fwd75 = r(estimate)
{txt} 66{com}. 
. 
.         *--------------------------------------------------------
.         * Private-public gap within comparison group
.         *--------------------------------------------------------
. 
.         quietly lincom ///
>             1.private ///
>             + 1.comp_group#1.private ///
>             + `p25' * 1.private#c.`hvar' ///
>             + `p25' * 1.comp_group#1.private#c.`hvar'
{txt} 67{com}.         local comp25 = r(estimate)
{txt} 68{com}. 
.         quietly lincom ///
>             1.private ///
>             + 1.comp_group#1.private ///
>             + `p50' * 1.private#c.`hvar' ///
>             + `p50' * 1.comp_group#1.private#c.`hvar'
{txt} 69{com}.         local comp50 = r(estimate)
{txt} 70{com}. 
.         quietly lincom ///
>             1.private ///
>             + 1.comp_group#1.private ///
>             + `p75' * 1.private#c.`hvar' ///
>             + `p75' * 1.comp_group#1.private#c.`hvar'
{txt} 71{com}.         local comp75 = r(estimate)
{txt} 72{com}. 
. 
.         *--------------------------------------------------------
.         * Sensitivity: ordinary PSU household composition
.         *--------------------------------------------------------
. 
.         capture noisily reghdfe `outcome' ///
>             i.comp_group##i.private##c.`hvar_raw' ///
>             `controls' ///
>             [aw = v005], ///
>             cluster(psu) absorb(sdist)
